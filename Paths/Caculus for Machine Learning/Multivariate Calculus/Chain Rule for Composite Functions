import numpy as np

def compute_chain_rule_gradient(functions: list[str], x: float) -> float:
	"""
	Compute derivative of composite functions using chain rule.
	
	Args:
		functions: List of function names (applied right to left)
		          Available: 'square', 'sin', 'exp', 'log'
		x: Point at which to evaluate derivative
	
	Returns:
		Derivative value at x
	
	Example:
		['sin', 'square'] represents sin(x²)
		['exp', 'sin', 'square'] represents exp(sin(x²))
	"""
	def apply_function(i, x):
		if i == 'square': 
			gx = x*x
			gdx = 2*x
		elif i == 'sin':
			gx = np.sin(x)
			gdx = np.cos(x)
		elif i == 'cos':
			gx = np.cos(x)
			gdx = -np.sin(x)
		elif i == 'exp':
			gx = np.exp(x)
			gdx = gx
		elif i == 'log':
			gx = np.log(x)
			gdx = 1/x
		return gx, gdx
	
	i = functions[-1]
	gx, gdx = apply_function(i, x)
	result = gdx
	
	for j in range(len(functions)-2,-1,-1):
		i = functions[j]
		fx, fdx = apply_function(i, gx)
		gx = fx
		result *= fdx
		
	return result
