def calculate_matrix_mean(matrix: list[list[float]], mode: str) -> list[float]:
	means = []
	cols = len(matrix[0])
	rows = len(matrix)
	if mode == 'column':
		for i in range(cols):
			total = 0
			for j in range(rows):
				total += matrix[j][i]
			means.append(total/rows)
	else:
		for i in range(rows):
			total = 0
			for j in range(cols):
				total += matrix[i][j]
			means.append(total/cols)
	return means
