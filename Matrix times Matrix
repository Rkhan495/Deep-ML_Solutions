import numpy as np

def matrixmul(a:list[list[int|float]],
              b:list[list[int|float]])-> list[list[int|float]]:
	
    if len(a[0]) != len(b):
        return -1

    c = np.zeros((len(a), len(b[0])))
    for i in range(len(a)):
        for j in range(len(b)):
            sum = 0
            for k in range(len(b[0])):
                sum += a[i][k] * b[k][j]
            c[i][j] = sum
    
    return c
