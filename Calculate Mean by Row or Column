def calculate_matrix_mean(matrix: list[list[float]], mode: str) -> list[float]:
	means = []
	if mode == 'column':
		m = len(matrix[0])
		n = len(matrix)
	else:
		m = len(matrix)
		n = len(matrix[0])
	for i in range(m):
		count = 0
		sum = 0
		for j in range(n):
			if mode == 'column':
				sum += matrix[j][i]
				count += 1
			else:
				sum += matrix[i][j]
				count += 1
		means.append(sum/count)
	return means
